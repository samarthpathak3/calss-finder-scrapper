# Copy this file to .env.local and fill in what you need. Restart `npm run dev` after changes.

# Optional: Google Places API key (much better results). Leave empty to use free OpenStreetMap data.
GOOGLE_MAPS_API_KEY=

# Optional: Google Sheets export. Use ONE of these two:
GOOGLE_SERVICE_ACCOUNT_FILE=./service_account.json
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}   (whole JSON on one line, handy on Vercel)

# Optional: default Google Sheet to export into
GOOGLE_SHEET_URL=
